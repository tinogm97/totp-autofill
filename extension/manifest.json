{
  "manifest_version": 3,
  "name": "TOTP Autofill",
  "version": "1.2.1",
  "description": "Rellena automáticamente los códigos 2FA (TOTP) en los formularios configurados en la app de escritorio TOTP Autofill.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "TOTP Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "fill-code": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Rellenar el código 2FA en la página actual"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "totp-autofill@tinogm97.github.io",
      "strict_min_version": "121.0"
    }
  }
}
